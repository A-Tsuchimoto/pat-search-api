# Google Cloud プロジェクト ID（自分の GCP プロジェクトを指定）
# 課金先プロジェクトとして使われる。公開データへの読み取り自体は無料枠あり。
GCP_PROJECT_ID=your-gcp-project-id

# サービスアカウントキー JSON のパス（下記「API 取得方法」参照）
# Application Default Credentials (gcloud auth) を使う場合は不要
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# 1 クエリあたりのスキャン上限 (GB)
# この量を超えるクエリはエラーで拒否され、課金されない（デフォルト 1.0 GB）
# BigQuery 無料枠 1TB/月 = 1000 GB。この値は月の上限ではなく 1 クエリの上限。
# BigQuery の日本語特許フルスキャンは約 150GB 必要。無料枠 1TB/月 の範囲内。
MAX_GB_PER_QUERY=200.0
