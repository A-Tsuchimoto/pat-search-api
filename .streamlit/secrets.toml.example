# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────────────────────
# 使い方:
#   ローカル: cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#             → secrets.toml を実際の値で編集して使う
#
#   Streamlit Cloud: このファイルの内容を
#                    アプリ設定 > Secrets に貼り付ける（ファイルは不要）
# ─────────────────────────────────────────────────────────────────────────────

# 1 クエリあたりのスキャン上限 (GB)。超過クエリはエラーで拒否される。
# 元テーブル: 約 200 GB。ステージングテーブル使用時は 20 に下げてよい。
MAX_GB_PER_QUERY = "200.0"

# ── ステージングテーブル設定（create_staging.py で一度作成してから有効化）──────
# USE_STAGING = "true" にするとステージングテーブルを使い、スキャン量を約1/10に削減
# USE_STAGING = "false"（またはコメントアウト）なら元テーブルをフルスキャン
USE_STAGING = "false"
STAGING_TABLE = "gen-lang-client-0731378894.patents_staging.jp_patents"

# サービスアカウントキーの JSON 内容をそのまま書く（ファイルパスではない）
# GCP コンソール > IAM > サービスアカウント > キー > JSON でダウンロードした
# ファイルの中身を以下の形式で貼り付ける
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN RSA PRIVATE KEY-----\nMIIE...(略)...QKBg\n-----END RSA PRIVATE KEY-----\n"
client_email = "your-sa-name@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-sa-name%40your-gcp-project-id.iam.gserviceaccount.com"
